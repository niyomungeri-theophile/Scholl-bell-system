rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'niyomungeritheophile02@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchool(data) {
      return data.keys().hasAll([
          'ownerId', 'schoolName', 'campusLocation', 'activeProfile',
          'autoRingEnabled', 'masterVolume', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'schoolName', 'campusLocation', 'activeProfile',
          'autoRingEnabled', 'masterVolume', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.schoolName is string && data.schoolName.size() >= 2 && data.schoolName.size() <= 140
        && data.campusLocation is string && data.campusLocation.size() >= 2 && data.campusLocation.size() <= 140
        && data.activeProfile in ['Studying', 'Exams', 'Regular', 'Exam', 'Half-Day']
        && data.autoRingEnabled is bool
        && data.masterVolume is number && data.masterVolume >= 0 && data.masterVolume <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBellSchedule(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'time', 'profile', 'zone',
          'tone', 'durationSec', 'days', 'enabled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'time', 'endTime', 'profile', 'zone',
          'tone', 'durationSec', 'days', 'examDate', 'teacherName', 'enabled', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.time is string && data.time.size() == 5 && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() == 5 && data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && data.profile in ['Studying', 'Exams', 'Regular', 'Exam', 'Half-Day']
        && data.zone is string && data.zone.size() >= 2 && data.zone.size() <= 80
        && data.tone in ['brass-bell', 'westminster-chime', 'gentle-tone', 'emergency-alert']
        && data.durationSec is number && data.durationSec >= 1 && data.durationSec <= 60
        && data.days is list && data.days.size() >= 1 && data.days.size() <= 7
        && data.days[0] is string
        && data.days.hasOnly(['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'])
        && (!('examDate' in data) || (data.examDate is string && data.examDate.size() <= 10 && data.examDate.matches('^$|^\\d{4}-\\d{2}-\\d{2}$')))
        && (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 100))
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCampusZone(data) {
      return data.keys().hasAll([
          'ownerId', 'name', 'building', 'speakerCount', 'enabled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'name', 'building', 'speakerCount', 'enabled', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.building is string && data.building.size() >= 2 && data.building.size() <= 100
        && data.speakerCount is number && data.speakerCount >= 1 && data.speakerCount <= 500
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRingLog(data) {
      return data.keys().hasAll(['ownerId', 'title', 'zone', 'tone', 'triggerType', 'triggeredAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'zone', 'tone', 'triggerType', 'triggeredAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.zone is string && data.zone.size() >= 2 && data.zone.size() <= 80
        && data.tone in ['brass-bell', 'westminster-chime', 'gentle-tone', 'emergency-alert']
        && data.triggerType in ['Automatic', 'Manual']
        && data.triggeredAt is timestamp;
    }

    function isValidSchoolUser(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'username', 'passwordHash', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'username', 'passwordHash', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.schoolId)
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 50
        && data.passwordHash is string && data.passwordHash.size() >= 16 && data.passwordHash.size() <= 200
        && data.role == 'school_user'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /schools/{schoolId} {
      allow get: if isValidId(schoolId) && (isOwner(schoolId) || isAdmin());
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(schoolId)
        && (isOwner(schoolId) || isAdmin())
        && isValidSchool(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(schoolId)
        && isValidSchool(incoming())
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'schoolName', 'campusLocation', 'activeProfile', 'autoRingEnabled', 'masterVolume', 'updatedAt'
          ])
        );
      allow delete: if isValidId(schoolId) && (existing().ownerId == request.auth.uid || isAdmin());

      match /schedules/{scheduleId} {
        allow get: if isValidId(schoolId) && isValidId(scheduleId)
          && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(schoolId) && isValidId(scheduleId)
          && isVerified()
          && isValidBellSchedule(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/schools/$(schoolId))
          && get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(schoolId) && isValidId(scheduleId)
          && isVerified()
          && isValidBellSchedule(incoming())
          && (existing().ownerId == request.auth.uid || isAdmin())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly(['enabled', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'time', 'endTime', 'profile', 'zone', 'tone', 'durationSec', 'days', 'examDate', 'teacherName', 'enabled', 'updatedAt'
            ])
          );
        allow delete: if isValidId(schoolId) && isValidId(scheduleId)
          && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
      }

      match /zones/{zoneId} {
        allow get: if isValidId(schoolId) && isValidId(zoneId)
          && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(schoolId) && isValidId(zoneId)
          && isVerified()
          && isValidCampusZone(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/schools/$(schoolId))
          && get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(schoolId) && isValidId(zoneId)
          && isVerified()
          && isValidCampusZone(incoming())
          && (existing().ownerId == request.auth.uid || isAdmin())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly(['enabled', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'building', 'speakerCount', 'enabled', 'updatedAt'])
          );
        allow delete: if isValidId(schoolId) && isValidId(zoneId)
          && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
      }

      match /logs/{logId} {
        allow get: if isValidId(schoolId) && isValidId(logId)
          && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(schoolId) && isValidId(logId)
          && isVerified()
          && isValidRingLog(incoming())
          && incoming().triggeredAt == request.time
          && exists(/databases/$(database)/documents/schools/$(schoolId))
          && get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(schoolId) && isValidId(logId)
          && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
      }

      match /schoolUsers/{staffId} {
        allow get: if isValidId(schoolId) && isValidId(staffId)
          && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(schoolId) && isValidId(staffId)
          && isVerified()
          && isValidSchoolUser(incoming())
          && incoming().schoolId == schoolId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/schools/$(schoolId))
          && get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(schoolId) && isValidId(staffId)
          && isVerified()
          && isValidSchoolUser(incoming())
          && (existing().ownerId == request.auth.uid || isAdmin())
          && incoming().ownerId == existing().ownerId
          && incoming().schoolId == existing().schoolId
          && incoming().role == existing().role
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly(['username', 'passwordHash', 'updatedAt'])
          );
        allow delete: if isValidId(schoolId) && isValidId(staffId)
          && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
      }
    }
  }
}
